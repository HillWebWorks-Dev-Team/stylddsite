{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mayaafricanhairbraid.com" }],
      "destination": "https://mayahair.styldd.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mayaafricanhairbraid.com" }],
      "destination": "https://mayahair.styldd.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/tenant", "destination": "/tenant/index.html" },
    { "source": "/marketing", "destination": "/marketing/index.html" },
    { "source": "/marketing/admin", "destination": "/marketing/admin.html" },
    { "source": "/login", "destination": "/marketing/login.html" },
    { "source": "/signup", "destination": "/login" },
    { "source": "/onboarding", "destination": "/marketing/onboarding.html" },
    { "source": "/dashboard", "destination": "/marketing/dashboard.html" },
    { "source": "/studio/main.js", "destination": "/marketing/studio/main.js" },
    { "source": "/studio/dashboard.js", "destination": "/marketing/studio/dashboard.js" },
    { "source": "/studio/dashboard.css", "destination": "/marketing/studio/dashboard.css" },
    { "source": "/studio/calendar.js", "destination": "/marketing/studio/calendar.js" },
    { "source": "/studio/calendar.css", "destination": "/marketing/studio/calendar.css" },
    { "source": "/studio/clients.js", "destination": "/marketing/studio/clients.js" },
    { "source": "/studio/clients.css", "destination": "/marketing/studio/clients.css" },
    { "source": "/studio/settings.js", "destination": "/marketing/studio/settings.js" },
    { "source": "/studio/settings.css", "destination": "/marketing/studio/settings.css" },
    { "source": "/studio/analytics.js", "destination": "/marketing/studio/analytics.js" },
    { "source": "/studio/analytics.css", "destination": "/marketing/studio/analytics.css" },
    { "source": "/studio/subscribe.js", "destination": "/marketing/studio/subscribe.js" },
    { "source": "/studio/subscribe.css", "destination": "/marketing/studio/subscribe.css" },
    { "source": "/studio/account-settings.js", "destination": "/marketing/studio/account-settings.js" },
    { "source": "/studio/website/edit", "destination": "/marketing/studio-edit.html" },
    { "source": "/studio/website/edit/:path*", "destination": "/marketing/studio-edit.html" },
    { "source": "/studio", "destination": "/marketing/studio.html" },
    { "source": "/studio/:path*", "destination": "/marketing/studio.html" },
    { "source": "/support", "destination": "/marketing/support.html" },
    { "source": "/privacy", "destination": "/marketing/privacy.html" },
    { "source": "/terms", "destination": "/marketing/terms.html" }
  ]
}
